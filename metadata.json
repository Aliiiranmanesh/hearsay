{
  "@context": {
    "@vocab": "https://schema.org/",
    "cr": "http://mlcommons.org/croissant/",
    "sc": "https://schema.org/",
    "rai": "http://mlcommons.org/croissant/RAI/",
    "dataBiases": "rai:dataBiases",
    "dataLimitations": "rai:dataLimitations",
    "dataUseCases": "rai:dataUseCases"
  },
  "@type": "sc:Dataset",
  "conformsTo": "http://mlcommons.org/croissant/1.0",
  "name": "hearsay-bench",
  "description": "HearSayBench contains 400 human-authored socio-legal scenarios, with in-region verification of a random sample of 200 prompts.",
  "license": "https://creativecommons.org/licenses/by/4.0/",
  "url": "https://github.com/Aliiiranmanesh/hearsay",
  "version": "1.0.0",
  "creator": {
    "@type": "sc:Person",
    "name": "HearSayBench Authors"
  },
  "rai:dataBiases": "The benchmark is designed to evaluate underrepresented situations and safety. Its English-language, synthetic scenarios reflect the limits of available documentation and controlled evaluation design.",
  "rai:dataLimitations": "HearSayBench contains exactly 400 curated scenarios. It is an evaluation benchmark, not a training corpus, and does not cover every human vulnerability or conversion factor.",
  "rai:dataUseCases": "Evaluating language-model understanding, capability reasoning, register appropriateness, uncertainty handling, and safety on constrained socio-legal scenarios.",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "hearsay.parquet",
      "name": "train-00000-of-00001.parquet",
      "description": "The published scenario dataset, with prompts, WEIRD institutional priors, categories, and subtypes.",
      "contentUrl": "https://huggingface.co/datasets/aliIranmanesh/hearsay/resolve/main/data/train-00000-of-00001.parquet",
      "encodingFormat": "application/vnd.apache.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "@id": "hearsay_scenarios",
      "name": "hearsay_scenarios",
      "description": "The 400 scenario records and their conversion-factor annotations.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "hearsay_scenarios/id",
          "name": "id",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "hearsay.parquet"
            },
            "extract": {
              "column": "id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "hearsay_scenarios/scenario",
          "name": "scenario",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "hearsay.parquet"
            },
            "extract": {
              "column": "scenario"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "hearsay_scenarios/prompt",
          "name": "prompt",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "hearsay.parquet"
            },
            "extract": {
              "column": "prompt"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "hearsay_scenarios/weird_prior",
          "name": "weird_prior",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "hearsay.parquet"
            },
            "extract": {
              "column": "weird_prior"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "hearsay_scenarios/category",
          "name": "category",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "hearsay.parquet"
            },
            "extract": {
              "column": "category"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "hearsay_scenarios/subtype",
          "name": "subtype",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "hearsay.parquet"
            },
            "extract": {
              "column": "subtype"
            }
          }
        }
      ]
    }
  ]
}
